# Loaded automatically by `vite build`. See .env.example for all variables.
#
# Intentionally EMPTY: the app calls relative "/api/..." paths and the reverse
# proxy in front of dist/ forwards them to the real API host, so the API
# address is a deploy-time config change (no rebuild) and no CORS is needed.
VITE_API_BASE_URL=https://hq-api-bo.orderx.vn

# Fill in for the production partner, or inject at build time in CI.
VITE_PARTNER_KEY=
