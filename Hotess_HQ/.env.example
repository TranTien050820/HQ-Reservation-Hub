# Copy to .env.local (dev) or .env.production (build) and fill in.
#
# --- Dev only ---------------------------------------------------------------
# Backend that the Vite dev server proxies "/api/*" to (see vite.config.ts).
# Has NO effect on a production build.
VITE_API_PROXY_TARGET=https://localhost:7018

# --- All environments -------------------------------------------------------
# Leave EMPTY to call the API via relative "/api/..." paths on the same origin.
# In dev that hits the Vite proxy; in production the reverse proxy in front of
# dist/ (see deploy/nginx.conf.example) forwards /api to the real API host.
# Only set this to an absolute URL if you want the browser to call the API host
# directly - that requires CORS to be enabled on the backend.
VITE_API_BASE_URL=

# Sent as the "PartnerKey" header on every request.
VITE_PARTNER_KEY=

# HMAC-SHA256 key for the "Token" header, only needed when the backend runs
# with CheckToken=true. WARNING: this is bundled into the client JS and is
# readable by anyone who loads the app - do not use a real secret on a
# publicly reachable deployment.
VITE_SECRET_KEY=
